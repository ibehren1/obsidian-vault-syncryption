{
	"name": "syncryption-plugin",
	"version": "0.1.0",
	"private": true,
	"description": "Vault Syncryption Obsidian plugin",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"api-types": "node scripts/api-types.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json ../manifest.json ../versions.json"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.6.4",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.13.0",
		"obsidian": "^1.13.1",
		"openapi-typescript": "^7.13.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^5.0.3"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents": false
	},
	"dependencies": {
		"@noble/ciphers": "^2.4.0",
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@scure/base": "^2.4.0",
		"age-encryption": "^0.3.1",
		"bcrypt-pbkdf": "^1.0.2",
		"node-diff3": "^3.2.1"
	}
}
