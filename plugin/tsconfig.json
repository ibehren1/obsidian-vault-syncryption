{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2022"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": []
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
